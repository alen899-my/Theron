{
  "name": "maps-pipeline-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js + Express backend for Google Maps scraping pipelines with Neon Postgres auth and deduped lead storage.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "playwright install chromium",
    "db:init": "node src/scripts/init-db.js",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "playwright": "^1.60.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
